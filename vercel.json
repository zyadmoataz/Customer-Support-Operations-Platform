{
  "version": 2,
  "buildCommand": "node scripts/build-all.mjs",
  "installCommand": "npm --prefix customer-portal install && npm --prefix support-workspace install",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/support/:path*",
      "destination": "/support/index.html"
    },
    {
      "source": "/support",
      "destination": "/support/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}

