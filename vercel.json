{
  "buildCommand": "node scripts/build-all.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/support/(.*)",
      "destination": "/support/index.html"
    },
    {
      "source": "/support",
      "destination": "/support/index.html"
    },
    {
      "source": "/((?!support).*)",
      "destination": "/index.html"
    }
  ]
}
