{
  "buildCommand": "node scripts/build-all.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/support/:path*",
      "destination": "/support/index.html"
    },
    {
      "source": "/support",
      "destination": "/support/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
